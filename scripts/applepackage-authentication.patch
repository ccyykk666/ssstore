+    private static func normalizedCookie(_ cookie: Cookie) -> Cookie {
+        var cookie = cookie
+        cookie.domain = cookie.domain.map { String($0.drop(while: { $0 == "." })).lowercased() }
+        return cookie
+    }
+
+    private func mergeAuthenticationCookies(_ response: HTTPClient.Response) {
+        guard let host = endpoint.host?.lowercased() else { return }
+        for header in response.headers["set-cookie"] {
+            for incoming in HTTPCookie.cookies(withResponseHeaderFields: ["Set-Cookie": header], for: endpoint) {
+                let domain = String(incoming.domain.drop(while: { $0 == "." })).lowercased()
+                guard domain == "apple.com" || domain.hasSuffix(".apple.com"),
+                      host == domain || host.hasSuffix("." + domain) else { continue }
+                cookies.removeAll {
+                    $0.name == incoming.name && $0.path == incoming.path && Self.normalizedCookie($0).domain == domain
+                }
+                let expiry = incoming.expiresDate?.timeIntervalSince1970
+                if incoming.value.isEmpty || expiry.map({ $0 <= Date().timeIntervalSince1970 }) == true { continue }
+                cookies.append(Cookie(name: incoming.name, value: incoming.value, path: incoming.path, domain: domain,
+                                      expiresAt: expiry, httpOnly: incoming.isHTTPOnly, secure: incoming.isSecure))
+            }
+        }
+    }
+
+    private static func hasAuthenticationVerdict(_ response: HTTPClient.Response) -> Bool {
+        guard let buffer = response.body, buffer.readableBytes > 0 else { return false }
+        guard buffer.readableBytes <= 2 * 1024 * 1024 else { return true }
+        let value = try? PropertyListSerialization.propertyList(from: Data(buffer.readableBytesView), format: nil)
+        guard let dictionary = value as? [String: Any] else { return false }
+        return ["failureType", "customerMessage", "accountInfo", "passwordToken", "dialog"].contains {
+            dictionary[$0] != nil
+        }
+    }
