+                cookies.append(Cookie(name: incoming.name, value: incoming.value, path: incoming.path, domain: domain,
+                                      expiresAt: expiry, httpOnly: incoming.isHTTPOnly, secure: incoming.isSecure))
+            }
+        }
+    }
