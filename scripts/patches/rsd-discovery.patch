+// Preserve every valid advertised endpoint. Entitlement is optional discovery
+// metadata, not an authorization decision by the client. Devices may encode
+// Port as either a decimal string or a plist integer.
+fn ssstore_parse_services(entries: &plist::Dictionary) -> HashMap<String, RsdService> {
+    let mut services = HashMap::new();
+    for (name, value) in entries {
+        let Some(entry) = value.as_dictionary() else { continue };
+        let port = entry.get("Port").and_then(|value| {
+            value.as_string().and_then(|s| s.parse::<u16>().ok()).or_else(|| {
+                value.as_unsigned_integer().and_then(|p| u16::try_from(p).ok())
+            })
+        }).filter(|p| *p != 0);
+        let Some(port) = port else { warn!("Ignoring RSD endpoint with invalid port: {name}"); continue };
+        let entitlement = entry.get("Entitlement").and_then(|v| v.as_string()).unwrap_or("").to_string();
+        let properties = entry.get("Properties").and_then(|p| p.as_dictionary());
+        let uses_remote_xpc = properties.and_then(|p| p.get("UsesRemoteXPC")).and_then(|v| v.as_boolean()).unwrap_or(false);
+        let features = properties.and_then(|p| p.get("Features")).and_then(|v| v.as_array()).map(|values| {
+            values.iter().filter_map(|v| v.as_string().map(str::to_string)).collect()
+        });
+        let service_version = properties.and_then(|p| p.get("ServiceVersion")).and_then(|v| v.as_signed_integer());
+        services.insert(name.clone(), RsdService { entitlement, port, uses_remote_xpc, features, service_version });
+    }
+    services
+}
