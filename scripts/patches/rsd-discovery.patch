+#[cfg(test)]
+mod ssstore_rsd_tests {
+    use super::*;
+    use plist::{Dictionary, Value};
+    fn endpoint(port: Value, entitlement: Option<&str>) -> Value {
+        let mut entry = Dictionary::new(); entry.insert("Port".into(), port);
+        if let Some(e) = entitlement { entry.insert("Entitlement".into(), Value::String(e.into())); }
+        let mut properties = Dictionary::new();
+        properties.insert("UsesRemoteXPC".into(), Value::Boolean(true));
+        properties.insert("Features".into(), Value::Array(vec![Value::String("listFiles".into())]));
+        properties.insert("ServiceVersion".into(), Value::Integer(2i64.into()));
+        entry.insert("Properties".into(), Value::Dictionary(properties)); Value::Dictionary(entry)
+    }
+    #[test]
+    fn ssstore_rsd_retains_optional_entitlement_and_integer_ports() {
+        let mut entries = Dictionary::new();
+        entries.insert("com.apple.coredevice.fileservice.control".into(), endpoint(Value::String("49152".into()), None));
+        entries.insert("legacy".into(), endpoint(Value::String("49153".into()), Some("required.entitlement")));
+        entries.insert("integer".into(), endpoint(Value::Integer(49154u64.into()), None));
+        let result = ssstore_parse_services(&entries);
+        assert_eq!(result.len(), 3);
+        let control = &result["com.apple.coredevice.fileservice.control"];
+        assert_eq!(control.port, 49152); assert!(control.entitlement.is_empty());
+        assert!(control.uses_remote_xpc); assert_eq!(control.features.as_ref().unwrap(), &vec!["listFiles".to_string()]);
+        assert_eq!(control.service_version, Some(2));
+        assert_eq!(result["legacy"].entitlement, "required.entitlement");
+        assert_eq!(result["integer"].port, 49154);
+    }
+    #[test]
+    fn ssstore_rsd_does_not_invent_absent_or_invalid_endpoints() {
+        let mut entries = Dictionary::new();
+        for (name, value) in [("zero", Value::Integer(0u64.into())), ("negative", Value::Integer((-1i64).into())),
+            ("tooLarge", Value::Integer(65536u64.into())), ("badText", Value::String("port".into()))] {
+            entries.insert(name.into(), endpoint(value, None));
+        }
+        entries.insert("notDictionary".into(), Value::String("49152".into()));
+        assert!(ssstore_parse_services(&entries).is_empty());
+    }
+}
