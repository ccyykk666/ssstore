+/// Captures one screenshot over the existing authenticated RSD tunnel.
+#[cfg(all(feature = "core_device_proxy", feature = "rsd"))]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ssstore_dvt_take_rsd_screenshot(
+    provider: *mut crate::core_device_proxy::AdapterHandle,
+    handshake: *mut crate::rsd::RsdHandshakeHandle,
+    data: *mut *mut u8,
+    len: *mut usize,
+) -> *mut IdeviceFfiError {
+    if provider.is_null() || handshake.is_null() || data.is_null() || len.is_null() {
+        return ffi_err!(idevice::IdeviceError::FfiInvalidArg);
+    }
+    let result = crate::run_sync_local(async {
+        idevice::dvt::screenshot::take_rsd_screenshot(
+            unsafe { &mut (*provider).0 },
+            unsafe { &mut (*handshake).0 },
+            std::time::Duration::from_secs(15),
+        ).await
+    });
+    match result {
+        Ok(image) if !image.is_empty() && image.len() <= 32 * 1024 * 1024 => {
+            let image = Box::leak(image.into_boxed_slice());
+            unsafe {
+                *data = image.as_mut_ptr();
+                *len = image.len();
+            }
+            null_mut()
+        }
+        Ok(_) => ffi_err!(idevice::IdeviceError::UnexpectedResponse(
+            "screenshot data is empty or exceeds 32 MiB".into()
+        )),
+        Err(error) => ffi_err!(error),
+    }
+}
