+#[cfg(all(feature = "rsd", not(target_arch = "wasm32")))]
+pub async fn take_rsd_screenshot(
+    provider: &mut impl crate::provider::RsdProvider,
+    handshake: &mut crate::services::rsd::RsdHandshake,
+    timeout: std::time::Duration,
+) -> Result<Vec<u8>, IdeviceError> {
+    let deadline = tokio::time::Instant::now() + timeout;
+    let mut server = screenshot_stage(deadline, "连接 Instruments 服务", handshake.connect(provider)).await?;
+    capture_screenshot(&mut server, deadline).await
+}
+
+#[cfg(all(feature = "rsd", not(target_arch = "wasm32")))]
+async fn capture_screenshot(
+    server: &mut RemoteServerClient<Box<dyn ReadWrite>>,
+    deadline: tokio::time::Instant,
+) -> Result<Vec<u8>, IdeviceError> {
+    let caps = crate::plist!(dict {
+        "com.apple.private.DTXBlockCompression": 0i64,
+        "com.apple.private.DTXConnection": 1i64,
+    });
+    // Send the host hello before waiting for the peer, as the DTX provider does.
+    screenshot_stage(
+        deadline,
+        "协商 Instruments 截图连接",
+        server.perform_handshake(Some(caps), deadline.saturating_duration_since(tokio::time::Instant::now())),
+    ).await?;
+    let mut client = screenshot_stage(deadline, "建立截图通道", ScreenshotClient::new(server)).await?;
+    screenshot_stage(deadline, "读取截图", client.take_screenshot()).await
+}
+
+#[cfg(all(feature = "rsd", not(target_arch = "wasm32")))]
+async fn screenshot_stage<T>(
+    deadline: tokio::time::Instant,
+    name: &str,
+    operation: impl std::future::Future<Output = Result<T, IdeviceError>>,
+) -> Result<T, IdeviceError> {
+    let failure = |detail: &str| IdeviceError::InternalError(format!("{name}：{detail}"));
+    match tokio::time::timeout_at(deadline, operation).await {
+        Ok(Ok(value)) => Ok(value),
+        Ok(Err(IdeviceError::Timeout)) | Err(_) => Err(failure("超时")),
+        Ok(Err(IdeviceError::Socket(error))) if error.kind() == std::io::ErrorKind::TimedOut => {
+            Err(failure("超时"))
+        }
+        #[cfg(feature = "xctest")]
+        Ok(Err(IdeviceError::XcTestTimeout(_))) => Err(failure("超时")),
+        Ok(Err(error)) => Err(failure(&format!("{error:?}"))),
+    }
+}
