+#[cfg(all(test, feature = "rsd", not(target_arch = "wasm32")))]
+#[tokio::test]
+async fn ssstore_screenshot_sends_hello_and_times_out_when_peer_is_silent() {
+    use tokio::{io::AsyncReadExt, time::{Duration, Instant}};
+    let (connection, mut peer) = tokio::io::duplex(4096);
+    let mut server = RemoteServerClient::with_label(connection, "screenshot-fixture");
+    let deadline = Instant::now() + Duration::from_millis(400);
+    let result = capture_screenshot(&mut server, deadline).await;
+    let error = result.unwrap_err();
+    assert!(matches!(&error, IdeviceError::InternalError(detail)
+        if detail.contains("协商 Instruments 截图连接") && detail.contains("超时")), "{error:?}");
+    drop(server);
+    let mut sent = Vec::new();
+    tokio::time::timeout(Duration::from_secs(2), peer.read_to_end(&mut sent)).await.unwrap().unwrap();
+    let hello = b"_notifyOfPublishedCapabilities:";
+    assert!(sent.windows(hello.len()).any(|bytes| bytes == hello));
+}
