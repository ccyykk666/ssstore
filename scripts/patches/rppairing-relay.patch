+// ssstore-only entry point. The caller supplies a loopback address for the
+// pairing channel and synchronously maps the negotiated device TLS port to a
+// second loopback relay. Both relays must outlive adapter/handshake. Returning
+// zero from the mapper cancels setup. Existing upstream entry points are unchanged.
+// Safety: all standard pointer contracts apply; relay_context and callback remain
+// valid until this synchronous function returns. No callback is retained.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ssstore_tunnel_create_rppairing_relay(
+    addr: *const idevice_sockaddr,
+    addr_len: idevice_socklen_t,
+    hostname: *const c_char,
+    pairing_file: *mut RpPairingFileHandle,
+    pin_callback: Option<extern "C" fn(context: *mut c_void) -> *const c_char>,
+    pin_context: *mut c_void,
+    map_tunnel_port: extern "C" fn(u16, *mut c_void) -> u16,
+    relay_context: *mut c_void,
+    out_adapter: *mut *mut AdapterHandle,
+    out_handshake: *mut *mut RsdHandshakeHandle,
+) -> *mut IdeviceFfiError {
+    if addr.is_null()
+        || hostname.is_null()
+        || pairing_file.is_null()
+        || out_adapter.is_null()
+        || out_handshake.is_null()
+    {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+
+    let socket_addr = match crate::util::c_socket_to_rust(addr as *const SockAddr, addr_len) {
+        Ok(a) => a,
+        Err(e) => return ffi_err!(e),
+    };
+    let host = match unsafe { CStr::from_ptr(hostname) }.to_str() {
+        Ok(s) => s.to_string(),
+        Err(_) => return ffi_err!(IdeviceError::FfiInvalidString),
+    };
+    let rpf = unsafe { &mut (*pairing_file).0 };
+    let ctx = PinCtx(pin_context);
+    let relay_ctx = PinCtx(relay_context);
+
+    let res = run_sync_local(async {
+        // Connect directly and use raw RPPairing protocol
+        let stream = run_global_timeout(|| tokio::net::TcpStream::connect(socket_addr))
+            .await
+            .map_err(|e| IdeviceError::InternalError(format!("connect: {e}")))?;
+        let conn = RpPairingSocket::new(stream);
+
+        let mut rpc = RemotePairingClient::new(conn, &host);
+        rpc.connect(rpf, async || get_pin(pin_callback, &ctx))
+            .await?;
+
+        finish_tunnel(&mut rpc, socket_addr, Some((map_tunnel_port, relay_ctx))).await
+    });
+
+    match res {
+        Ok((adapter, handshake)) => {
+            write_result(adapter, handshake, out_adapter, out_handshake);
+            null_mut()
+        }
+        Err(e) => ffi_err!(e),
+    }
+}
